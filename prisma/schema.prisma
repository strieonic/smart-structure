generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ENGINEER
  EXPERT
  ADMIN
}

enum ExpertType {
  STRUCTURAL_ENGINEER
  ARCHITECT
  CIVIL_ENGINEER
  GEOTECHNICAL_ENGINEER
}

enum ExpertStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum SoilType {
  CLAY
  BLACK_COTTON
  LATERITE
  SANDY
  ROCKY
  ALLUVIAL
}

enum SeismicZone {
  ZONE_II
  ZONE_III
  ZONE_IV
  ZONE_V
}

enum FloodRisk {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  HOSPITAL
  SCHOOL
  INDUSTRIAL
  MIXED_USE
}

enum StructuralSystem {
  RCC
  STEEL
  COMPOSITE
  LOAD_BEARING
}

enum Orientation {
  NORTH
  NORTH_EAST
  EAST
  SOUTH_EAST
  SOUTH
  SOUTH_WEST
  WEST
  NORTH_WEST
}

enum FoundationType {
  SHALLOW
  DEEP_PILE
  RAFT
  COMBINED
}

enum HeightCategory {
  LOW_RISE
  MID_RISE
  HIGH_RISE
  SUPER_HIGH_RISE
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  landSurveys   LandSurvey[]
  auditLogs     AuditLog[]
  expertProfile ExpertProfile?
  expertQueries ExpertQuery[]
  
  @@index([email])
  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  resource    String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model LandSurvey {
  id                    String      @id @default(uuid())
  userId                String
  
  // Location Data
  latitude              Float
  longitude             Float
  plotArea              Float       // in sq.m
  
  // Soil & Terrain
  soilType              SoilType
  slope                 Float       // in degrees
  elevation             Float       // in meters
  waterTableDepth       Float       // in meters
  
  // Disaster Risk
  seismicZone           SeismicZone
  floodRisk             FloodRisk
  nearbyWaterBodies     Boolean     @default(false)
  waterBodyDistance     Float?      // in meters
  historicalDisasters   Json?       // Array of past disasters
  
  // Climate Data
  averageRainfall       Float?      // mm/year
  maxTemperature        Float?      // Celsius
  minTemperature        Float?      // Celsius
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingInputs        BuildingInput[]
  
  @@index([userId])
  @@index([seismicZone, floodRisk])
  @@map("land_surveys")
}

model BuildingInput {
  id                  String            @id @default(uuid())
  landSurveyId        String
  
  // Building Specifications
  buildingType        BuildingType
  totalFloors         Int
  floorHeight         Float             // in meters
  totalHeight         Float             // in meters
  builtUpArea         Float             // in sq.m
  orientation         Orientation
  structuralSystem    StructuralSystem
  
  // Additional Details
  basementFloors      Int               @default(0)
  parkingFloors       Int               @default(0)
  expectedOccupancy   Int?
  
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  
  landSurvey          LandSurvey        @relation(fields: [landSurveyId], references: [id], onDelete: Cascade)
  windData            WindData?
  disasterAnalysis    DisasterAnalysis?
  vastuReport         VastuReport?
  finalReport         FinalReport?
  buildingProject     BuildingProject?
  
  @@index([landSurveyId])
  @@map("building_inputs")
}

model WindData {
  id                    String   @id @default(uuid())
  buildingInputId       String   @unique
  
  // Wind Parameters
  windDirection         Float    // in degrees (0-360)
  averageWindSpeed      Float    // in m/s
  peakGustSpeed         Float    // in m/s
  terrainRoughness      String   // Category 1-4
  
  // Calculated Values
  windPressure          Float    // in kN/m²
  windLoad              Float    // in kN
  
  // Recommendations
  optimalOrientation    Orientation
  aerodynamicForm       String
  ventilationStrategy   Json
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  buildingInput         BuildingInput @relation(fields: [buildingInputId], references: [id], onDelete: Cascade)
  
  @@map("wind_data")
}

model DisasterAnalysis {
  id                      String   @id @default(uuid())
  buildingInputId         String   @unique
  
  // Load Calculations
  deadLoad                Float    // in kN
  liveLoad                Float    // in kN
  windLoad                Float    // in kN
  seismicLoad             Float    // in kN
  totalLoad               Float    // in kN
  
  // Height Classification
  heightCategory          HeightCategory
  
  // Foundation Recommendation
  recommendedFoundation   FoundationType
  foundationDepth         Float    // in meters
  
  // Structural Recommendations
  columnSpacing           Float    // in meters
  beamSizing              String   // Logical description
  shearWallRequired       Boolean
  
  // Earthquake Analysis
  earthquakeSafetyScore   Float    // 0-100
  baseShear               Float    // in kN
  softStoryDetected       Boolean
  shearWallPlacement      Json
  
  // Flood Analysis
  minimumPlinthHeight     Float    // in meters
  drainageSlope           Float    // in percentage
  basementFeasible        Boolean
  waterResistantMaterials Json
  
  // Wind/Cyclone Analysis
  vortexSheddingRisk      String   // LOW, MEDIUM, HIGH
  heightToWidthRatio      Float
  pressureZones           Json
  shapeOptimization       String
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  buildingInput           BuildingInput @relation(fields: [buildingInputId], references: [id], onDelete: Cascade)
  
  @@map("disaster_analysis")
}

model VastuReport {
  id                      String   @id @default(uuid())
  buildingInputId         String   @unique
  
  // Input Parameters
  plotShape               String
  entranceDirection       Orientation
  
  // Vastu Compliance
  vastuComplianceScore    Float    // 0-100
  overallCompliance       String   // EXCELLENT, GOOD, MODERATE, POOR
  
  // Zone Analysis
  entranceSuitability     String
  kitchenZoneCompliance   Boolean
  bedroomZoneCompliance   Boolean
  staircaseCompliance     Boolean
  waterTankDirection      String
  borewellDirection       String
  
  // Violations & Corrections
  violations              Json     // Array of violation objects
  corrections             Json     // Array of correction suggestions
  
  // Wind-Vastu Integration
  windVastuCompatibility  String
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  buildingInput           BuildingInput @relation(fields: [buildingInputId], references: [id], onDelete: Cascade)
  
  @@map("vastu_reports")
}

model FinalReport {
  id                      String   @id @default(uuid())
  buildingInputId         String   @unique
  
  // Composite Scores
  overallSafetyScore      Float    // 0-100
  costEfficiencyScore     Float    // 0-100
  sustainabilityScore     Float    // 0-100
  vastuScore              Float    // 0-100
  
  // Summary Sections
  surveySummary           Json
  riskAnalysis            Json
  structuralLogic         Json
  vastuSummary            Json
  finalRecommendations    Json
  
  // Status
  reportStatus            String   @default("GENERATED")
  generatedAt             DateTime @default(now())
  
  buildingInput           BuildingInput @relation(fields: [buildingInputId], references: [id], onDelete: Cascade)
  
  @@map("final_reports")
}

// ============================================
// AI-POWERED GOVERNMENT RULES SYSTEM
// ============================================

enum ZoneType {
  RURAL
  URBAN
  SEMI_URBAN
  INDUSTRIAL
  AGRICULTURAL
}

enum RuleCategory {
  FSI
  HEIGHT_LIMIT
  SETBACK
  BUILDING_SPACING
  FOUNDATION_DEPTH
  PARKING
  FIRE_SAFETY
  VENTILATION
  SANITATION
  ACCESSIBILITY
}

enum RuleStatus {
  ACTIVE
  DEPRECATED
  PROPOSED
}

model GovernmentRule {
  id                String        @id @default(uuid())
  
  // Location Specificity
  country           String        @default("India")
  state             String        // e.g., "Maharashtra", "Delhi"
  city              String?       // Optional: specific city
  zoneType          ZoneType
  
  // Rule Details
  ruleCategory      RuleCategory
  ruleCode          String        // e.g., "FSI-MH-2023-001"
  title             String
  description       String        @db.Text
  
  // Conditions & Values
  conditions        Json          // Conditions when rule applies
  minValue          Float?
  maxValue          Float?
  unit              String?       // meters, percentage, ratio
  formula           String?       @db.Text
  
  // Metadata
  source            String        // Government body/document
  sourceUrl         String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            RuleStatus    @default(ACTIVE)
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  complianceChecks  ComplianceCheck[]
  
  @@index([state, city, zoneType, ruleCategory])
  @@index([status, effectiveFrom])
  @@map("government_rules")
}

model LocationData {
  id                String    @id @default(uuid())
  
  // Coordinates
  latitude          Float
  longitude         Float
  
  // Geocoded Information
  country           String
  state             String
  city              String
  district          String?
  pincode           String?
  locality          String?
  
  // Classification
  zoneType          ZoneType
  isMetro           Boolean   @default(false)
  
  // Administrative
  municipalWard     String?
  taluka            String?
  
  // Cached Data
  formattedAddress  String    @db.Text
  geocodedAt        DateTime  @default(now())
  
  // Relations
  buildingProjects  BuildingProject[]
  
  @@index([state, city, zoneType])
  @@index([latitude, longitude])
  @@map("location_data")
}

model BuildingProject {
  id                    String              @id @default(uuid())
  userId                String
  locationId            String
  buildingInputId       String?             @unique
  
  // Project Details
  projectName           String
  projectType           BuildingType
  status                String              @default("DRAFT") // DRAFT, ANALYZING, COMPLETED
  
  // AI Analysis
  aiAnalysisRequested   Boolean             @default(false)
  aiAnalysisCompleted   Boolean             @default(false)
  aiAnalysisResult      Json?
  
  // Timestamps
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  location              LocationData        @relation(fields: [locationId], references: [id])
  buildingInput         BuildingInput?      @relation(fields: [buildingInputId], references: [id])
  complianceChecks      ComplianceCheck[]
  chatSessions          ChatSession[]
  
  @@index([userId, status])
  @@index([locationId])
  @@map("building_projects")
}

model ComplianceCheck {
  id                    String          @id @default(uuid())
  projectId             String
  ruleId                String
  
  // Check Results
  isCompliant           Boolean
  actualValue           Float?
  requiredValue         Float?
  deviation             Float?          // Percentage deviation
  
  // Details
  checkDetails          Json
  severity              String          // CRITICAL, HIGH, MEDIUM, LOW
  recommendation        String          @db.Text
  
  // AI Enhancement
  aiExplanation         String?         @db.Text
  aiSuggestions         Json?
  
  // Timestamps
  checkedAt             DateTime        @default(now())
  
  // Relations
  project               BuildingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rule                  GovernmentRule  @relation(fields: [ruleId], references: [id])
  
  @@index([projectId, isCompliant])
  @@index([ruleId])
  @@map("compliance_checks")
}

model ChatSession {
  id                String        @id @default(uuid())
  projectId         String
  userId            String
  
  // Session Details
  sessionTitle      String        @default("New Consultation")
  isActive          Boolean       @default(true)
  
  // Context
  conversationContext Json        // Stores conversation history
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  project           BuildingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages          ChatMessage[]
  
  @@index([projectId, userId])
  @@index([isActive, updatedAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id                String        @id @default(uuid())
  sessionId         String
  
  // Message Details
  role              String        // user, assistant, system
  content           String        @db.Text
  
  // Metadata
  tokens            Int?
  model             String?       // gpt-4, gpt-3.5-turbo, etc.
  
  // Context
  contextData       Json?         // Additional context sent with message
  
  // Timestamps
  createdAt         DateTime      @default(now())
  
  // Relations
  session           ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ============================================
// EXPERT SYSTEM MODELS
// ============================================

model ExpertProfile {
  id                    String        @id @default(uuid())
  userId                String        @unique
  
  // Professional Details
  expertType            ExpertType
  licenseNumber         String
  experience            String        // "5-10", "10-15", "15-20", "20+"
  location              String
  phone                 String
  
  // Specializations
  specializations       Json          // Array of specialization strings
  summary               String?       @db.Text
  
  // Status & Verification
  status                ExpertStatus  @default(PENDING)
  verifiedAt            DateTime?
  verifiedBy            String?
  
  // Portfolio
  portfolioData         Json?         // Portfolio information
  
  // Timestamps
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  
  // Relations
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedQueries       ExpertQuery[]
  
  @@index([status, expertType])
  @@index([location, expertType])
  @@map("expert_profiles")
}

model ExpertQuery {
  id                    String        @id @default(uuid())
  userId                String        // User who posted the query
  expertId              String?       // Assigned expert
  
  // Query Details
  title                 String
  description           String        @db.Text
  category              String        // "foundation", "seismic", "vastu", etc.
  priority              String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  // Project Context
  projectId             String?
  attachments           Json?         // File attachments
  
  // Status
  status                String        @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  
  // Response
  expertResponse        String?       @db.Text
  responseAt            DateTime?
  
  // Timestamps
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  
  // Relations
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert                ExpertProfile? @relation(fields: [expertId], references: [id])
  
  @@index([status, category])
  @@index([expertId, status])
  @@index([userId])
  @@map("expert_queries")
}